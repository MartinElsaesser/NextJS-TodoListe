{
  "name": "nextjs-todoliste",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db-init": "npm run db-init-schema && npm run db-seed",
    "db-seed": "tsx src/db/seed/index.ts",
    "db-gen-types": "kysely-codegen --out-file=src/db/schema/db-types.ts",
    "db-init-schema": "tsx src/db/schema/init-schema.ts",
    "prettier:fix": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "kysely": "^0.28.2",
    "next": "15.3.2",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.15.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "kysely-codegen": "^0.18.5",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
